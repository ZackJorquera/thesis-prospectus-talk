%%% Fixes for \bra, \ket, and \braket
% Initially From: https://tex.stackexchange.com/a/288752/303504
\makeatletter
\renewcommand\ket[1]{%
  \@ifnextchar\bra{\k@t{#1}\!}{%
    \@ifnextchar\braket{\k@t{#1}\!}{\k@t{#1}}%
  }%
}
\newcommand\k@t[1]{{|{#1}\rangle}}
\makeatother

\makeatletter
\renewcommand\braket[1]{%
  \@ifnextchar\bra{\br@k@t{#1}\!}{%
    \@ifnextchar\braket{\br@k@t{#1}\!}{\br@k@t{#1}}%
  }%
}
\newcommand\br@k@t[1]{{\langle{#1}\rangle}}
\makeatother

%\renewcommand\bra[1]{{\langle{#1}|}}
\makeatletter % I dont see the point of ever using `\bra{a}\ket{b}` and not wanting <a|b>. If you want two lines it is better to use `\|`.
\renewcommand\bra[1]{%
  \@ifnextchar\ket{\br@nv{#1}}{\br@{#1}}%
}
\newcommand\br@[1]{{\langle{#1}|}}
\newcommand\br@nv[1]{{\langle{#1}}}
\makeatother

